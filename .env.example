# Lokale dev werkt zonder env vars (gebruikt lokaal SQLite-bestand + lokale uploads/).
# Voor Vercel deployment vul je deze in als environment variables.

# Turso (SQLite-compatibele cloud DB) — gratis tier op turso.tech
# TURSO_DATABASE_URL=libsql://xxx-xxx.turso.io
# TURSO_AUTH_TOKEN=eyJhbGc...

# Vercel Blob (foto-uploads)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
